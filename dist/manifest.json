{
  "manifest_version": 3,
  "name": "My TypeScript Extension",
  "version": "1.0.0",
  "description": "A Chrome Extension using TypeScript and Webpack",
  "content_scripts": [
    {
      "matches": ["https://www.minecraft-schematics.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}