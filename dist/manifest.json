{
  "manifest_version": 3,
  "name": "Minecraft Schematics Hide Paid",
  "version": "0.0.1",
  "description": "Hides paid schematics on minecraft-schematics.com",
  "content_scripts": [
    {
      "matches": ["https://www.minecraft-schematics.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}